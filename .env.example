# Supabase (project settings -> API / Database)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_JWT_SECRET=
# Postgres connection string (SQLAlchemy async/sync driver)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# GitHub fine-grained PAT (public repo read access is enough)
GITHUB_TOKEN=
LOG_LEVEL=INFO
